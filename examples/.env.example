# AgentMemory credentials. The API key is a secret — Hermes writes it to .env when
# you run `hermes memory setup`. Copy to `.env` and fill in for local runs.

AGENT_MEMORY_API_KEY=
AGENT_MEMORY_ENDPOINT=https://your-instance.agent_memory.dev
AGENT_MEMORY_CONTEXT=my-context

# Optional (otherwise sourced from agent_memory.json / defaults):
# AGENT_MEMORY_RECALL_MODE=hybrid
# AGENT_MEMORY_WRITE_FREQUENCY=turn
# AGENT_MEMORY_TOP_K=5
# AGENT_MEMORY_DEFAULT_SCOPE=user/tobie
